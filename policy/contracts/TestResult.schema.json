{
  "$id": "TestResult.schema.json",
  "title": "TestResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "description": "파이프라인 실행 id. 영문·숫자·._- 만, 1~64자. 모든 파일이 같은 값을 가져야 한다"
    },
    "app": {
      "type": "string",
      "minLength": 1,
      "description": "앱 이름"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "컨테이너 이미지 지문. 'sha256:' + 소문자 hex 64자. 테스트한 이미지 = 결정한 이미지 = 서명·배포할 이미지"
    },
    "source_revision": {
      "description": "테스트한 소스의 커밋 SHA (선택). 소문자 hex 7~40자. \"unknown\" 은 없는 것으로 취급한다",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "테스트한 소스의 커밋 SHA. 소문자 hex 7~40자"
        },
        {
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "passed": {
      "type": "boolean",
      "description": "재생 테스트 통과 여부. false 면 정책 엔진이 차단한다"
    },
    "match": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "재생한 요청 수"
        },
        "matched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "응답이 일치한 요청 수"
        }
      },
      "required": [
        "total",
        "matched"
      ],
      "description": "재생 결과 요약"
    },
    "failures": {
      "default": [],
      "description": "실패한 요청 목록. 형식은 테스트 파트가 정한다 (정책 엔진은 내용을 보지 않음)",
      "type": "array",
      "items": {}
    },
    "facts": {
      "default": {},
      "type": "object",
      "properties": {
        "db": {
          "description": "앱이 쓰는 DB. 소문자만. R5 가 읽는다",
          "type": "string",
          "enum": [
            "sqlite",
            "postgres",
            "mysql",
            "none"
          ]
        },
        "writes_local_file": {
          "description": "앱이 쓰는 로컬 파일 경로 목록. R6 가 읽는다",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "migration": {
          "type": "object",
          "properties": {
            "destructive": {
              "type": "boolean",
              "description": "파괴적 변경이 하나라도 있는지. R7 이 읽는다"
            },
            "backward_compatible": {
              "type": "boolean",
              "description": "이전 버전과 호환되는지 = 파괴적 변경이 없을 때 true"
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "drop_table",
                      "drop_column",
                      "rename_table",
                      "rename_column",
                      "alter_column_type",
                      "add_not_null_without_default",
                      "set_not_null",
                      "truncate"
                    ],
                    "description": "파괴적 변경의 종류"
                  },
                  "statement": {
                    "type": "string",
                    "description": "해당 SQL 문장 (한 줄로 줄임)"
                  },
                  "evidence": {
                    "type": "string",
                    "description": "위치 '파일:줄'"
                  }
                },
                "required": [
                  "kind",
                  "statement",
                  "evidence"
                ],
                "description": "파괴적 변경 하나"
              },
              "description": "파괴적 변경 목록. 없으면 빈 배열"
            }
          },
          "required": [
            "destructive",
            "backward_compatible",
            "findings"
          ],
          "description": "파괴적 DB 마이그레이션 판정. 실행기(src/stage.ts)가 facts.migration 이 없으면 채운다"
        }
      },
      "additionalProperties": {},
      "description": "테스트 중 관찰한 사실. 정의된 키(db, writes_local_file, migration)는 타입이 고정되고, 그 밖의 키는 자유"
    }
  },
  "required": [
    "run_id",
    "app",
    "digest",
    "passed",
    "match"
  ],
  "description": "테스트 파트가 만드는 테스트 판정 결과"
}
