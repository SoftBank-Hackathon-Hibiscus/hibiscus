{
  "$id": "DecisionLog.schema.json",
  "title": "DecisionLog",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "deploy",
          "description": "배포 결정"
        },
        "time": {
          "type": "string",
          "description": "결정 시각 (ISO 8601). CLI 가 붙인다. 엔진은 시간을 쓰지 않는다"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "description": "파이프라인 실행 id. 모든 파일이 같은 값을 가져야 한다"
        },
        "digest": {
          "type": "string",
          "description": "결정한 이미지의 digest (plan.digest)"
        },
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "block",
            "needs_approval"
          ],
          "description": "allow=배포 진행, block=배포 안 함, needs_approval=사람 승인 후 진행"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "plan.targets"
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "걸린 규칙 id 만 (plan 의 rules 중 matched)"
        },
        "plan_hash": {
          "type": "string",
          "description": "plan.plan_hash"
        }
      },
      "required": [
        "kind",
        "time",
        "run_id",
        "digest",
        "decision",
        "targets",
        "rule_ids",
        "plan_hash"
      ],
      "additionalProperties": false,
      "description": "배포 결정 한 건"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "rollback",
          "description": "롤백 결정"
        },
        "time": {
          "type": "string",
          "description": "결정 시각 (ISO 8601). CLI 가 붙인다. 엔진은 시간을 쓰지 않는다"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "description": "파이프라인 실행 id. 모든 파일이 같은 값을 가져야 한다"
        },
        "digest": {
          "type": "string",
          "description": "문제가 난 배포 후보(candidate)의 digest"
        },
        "serve_digest": {
          "description": "결정 후 트래픽을 받을 버전. manual_recovery 면 null",
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "keep_stable",
            "rollback",
            "manual_recovery"
          ],
          "description": "keep_stable=정상 버전이 계속 트래픽을 받음, rollback=정상 버전으로 되돌림, manual_recovery=자동으로 못 되돌림 (사람이 복구)"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "rollback_plan.targets"
        },
        "failover_allowed": {
          "type": "boolean",
          "description": "rollback_plan.failover_allowed"
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "걸린 규칙 id 만 (plan 의 rules 중 matched)"
        },
        "plan_hash": {
          "type": "string",
          "description": "rollback_plan.plan_hash"
        }
      },
      "required": [
        "kind",
        "time",
        "run_id",
        "digest",
        "serve_digest",
        "decision",
        "targets",
        "failover_allowed",
        "rule_ids",
        "plan_hash"
      ],
      "additionalProperties": false,
      "description": "롤백 결정 한 건"
    }
  ],
  "description": "decisions.jsonl 의 한 줄. kind 로 배포/롤백을 구분한다. 추가만 하고 수정하지 않는다"
}
