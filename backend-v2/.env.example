HOST=127.0.0.1
PORT=8080
DATABASE_FILE=./data/backend.db
WORKER_POLL_MS=250
REPO_ROOT=..
# 기존 CLI 입출력용 임시 폴더. 비워 두면 OS 임시 폴더 사용.
CLI_TEMP_DIR=
STAGE_MODE=skeleton
SIGNER_MODE=dry
DEPLOY_MODE=off
POLICY_TIMEOUT_MS=180000
SIGNER_TIMEOUT_MS=180000
AGENT_OFFLINE_AFTER_MS=30000
AGENT_CANDIDATE_LEASE_MS=120000
AGENT_ACTION_LEASE_MS=30000
GATEWAY_IDLE_TIMEOUT_MS=60000
HEALTH_MONITOR_ENABLED=true
HEALTH_MONITOR_TICK_MS=1000
SSH_FORWARD_PORT_MIN=20000
SSH_FORWARD_PORT_MAX=29999
SSH_FORWARD_CONNECT_TIMEOUT_MS=3000
SSH_HOST=backend.example.com
SSH_PORT=22
SSH_USER=hibiscus-agent
# VM의 실제 host key 지문으로 반드시 교체
SSH_HOST_KEY_SHA256=SHA256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
SSH_ENROLLMENT_TTL_SECONDS=600

# npm이 PATH에 없을 때만 npm 실행 파일의 절대 경로를 지정
NPM_COMMAND=

# GitHub App의 Client ID와 Client Secret. App ID나 Private Key가 아닙니다.
# Callback은 JSON을 반환합니다.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=http://localhost:8080/auth/github/callback
# 로그인할 수 있는 GitHub 숫자 사용자 ID. 여러 명은 쉼표로 구분합니다.
# 비어 있으면 Backend가 시작되지 않습니다.
ALLOWED_GITHUB_IDS=
# GitHub App 설치 주소에 쓰는 slug (선택)
GITHUB_APP_SLUG=
# Webhook을 사용할 때 필수. 최소 32자.
GITHUB_WEBHOOK_SECRET=
# GitHub 토큰 암호화 키. openssl rand -hex 32로 생성. 운영에서 고정 보관.
GITHUB_TOKEN_ENCRYPTION_KEY=
# 각각 다른 무작위 문자열을 넣으세요. 최소 32자입니다.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
