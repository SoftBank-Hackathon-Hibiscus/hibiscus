HOST=127.0.0.1
PORT=8080
DATABASE_FILE=./data/backend.db
WORKER_POLL_MS=250
REPO_ROOT=..
# 기존 CLI 입출력용 임시 폴더. 비워 두면 OS 임시 폴더 사용.
CLI_TEMP_DIR=
STAGE_MODE=skeleton
SIGNER_MODE=dry
DEPLOY_MODE=off
POLICY_TIMEOUT_MS=180000
SIGNER_TIMEOUT_MS=180000
AGENT_OFFLINE_AFTER_MS=30000
AGENT_CANDIDATE_LEASE_MS=120000
AGENT_ACTION_LEASE_MS=30000
TUNNEL_PING_INTERVAL_MS=10000
TUNNEL_HEARTBEAT_TIMEOUT_MS=30000
TUNNEL_OPEN_TIMEOUT_MS=5000
TUNNEL_MAX_CHANNELS_PER_AGENT=100
TUNNEL_MAX_FRAME_BYTES=1048576

# npm이 PATH에 없을 때만 npm 실행 파일의 절대 경로를 지정
NPM_COMMAND=

# GitHub App의 Client ID와 Client Secret. App ID나 Private Key가 아닙니다.
# Callback은 JSON을 반환합니다.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=http://localhost:8080/auth/github/callback
# GitHub App 설치 주소에 쓰는 slug (선택)
GITHUB_APP_SLUG=
# Webhook을 사용할 때 필수. 최소 32자.
GITHUB_WEBHOOK_SECRET=
# GitHub 토큰 암호화 키. openssl rand -hex 32로 생성. 운영에서 고정 보관.
GITHUB_TOKEN_ENCRYPTION_KEY=
# 각각 다른 무작위 문자열을 넣으세요. 최소 32자입니다.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# 배포 단계 (DEPLOY_MODE=real). 비어 있는 경로는 REPO_ROOT 기준 기본값을 쓴다
# GCP 프로젝트가 비어 있으면 cloud_run 대상 배포는 거부된다. PROJECT_ID·REGION 이 있으면 그것도 읽는다
GCP_PROJECT_ID=
GCP_REGION=asia-northeast3
# 비우면 Application slug 를 Cloud Run 서비스 이름으로 쓴다
CLOUD_RUN_SERVICE=
CLOUD_RUN_TAG=cand
# 기본: <REPO_ROOT>/deploy/cloudrun
CLOUD_RUN_SCRIPTS_DIR=
COSIGN_COMMAND=cosign
# 서명 확인 공개키. 기본: <REPO_ROOT>/signer/keys/cosign.pub
COSIGN_PUBLIC_KEY=
DEPLOY_SCRIPT_TIMEOUT_MS=300000
DEPLOY_CANDIDATE_TIMEOUT_MS=120000
DEPLOY_ACTION_TIMEOUT_MS=30000
DEPLOY_JOB_POLL_MS=2000
