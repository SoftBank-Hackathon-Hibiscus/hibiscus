# backend 환경변수 예시. 값은 비워 두었다. 실제 값은 .env 에 두고 커밋하지 않는다.

# 서버. HOST 기본 127.0.0.1 (webhook·인증이 붙기 전에는 외부 공개용이 아님). 바깥에 열려면 명시적으로 0.0.0.0
HOST=127.0.0.1
PORT=8080

# 실행 산출물 폴더. run 마다 runs/<run_id>/ 가 생긴다 (기본 backend/.work)
WORK_DIR=

# 레포 루트. policy/, signer/ 를 여기서 찾는다 (기본 backend 의 상위 폴더)
REPO_ROOT=

# 서명 모드: dry (기본, cosign 없이 --dry-run) | real (cosign 키 필요)
SIGNER_MODE=dry

# 배포 모드: off (기본, deploy 단계를 skipped 로 기록) | dry | real (둘 다 아직 미구현)
DEPLOY_MODE=off

# SIGNER_MODE=real 일 때만. signer CLI 가 읽는다
SIGNER_COSIGN_KEY=
COSIGN_PASSWORD=

# 다음 PR (webhook, 소스 체크아웃) 에서 사용. 지금은 읽지 않는다
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
