{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PremortemHandoffBundleV1",
  "description": "김주영 모듈 내부 계약 구현안 v1. 팀 공통 test_result 계약이 아니다.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]{1,64}$"
    },
    "mode": {
      "enum": [
        "pending_team_integration",
        "validated_team_integration"
      ],
      "type": "string"
    },
    "ready_for_policy": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "출력 또는 앱 root 기준 상대 경로. 실제 구현에서 절대 경로·..·역슬래시·드라이브·symlink·root 이탈을 추가 검증한다."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "ready_for_policy",
    "blockers",
    "artifacts",
    "note"
  ],
  "additionalProperties": false
}
