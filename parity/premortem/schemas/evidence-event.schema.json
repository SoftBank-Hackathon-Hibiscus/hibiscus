{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PremortemEvidenceEventV1",
  "description": "김주영 모듈 내부 계약 구현안 v1. 팀 공통 test_result 계약이 아니다.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]{1,64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]{1,64}$"
    },
    "condition": {
      "enum": [
        "none",
        "restart",
        "replace",
        "replicas",
        "remote_verify"
      ],
      "type": "string"
    },
    "request_index": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "lifecycle",
        "http_mismatch",
        "readiness",
        "listen_socket",
        "file_change",
        "container_log",
        "image_identity",
        "source_identity",
        "baseline_identity",
        "tool_error"
      ],
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "sanitized_summary": {
      "type": "string"
    },
    "artifact_relative_path": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "출력 또는 앱 root 기준 상대 경로. 실제 구현에서 절대 경로·..·역슬래시·드라이브·symlink·root 이탈을 추가 검증한다."
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "run_id",
    "condition",
    "request_index",
    "kind",
    "observed_at",
    "sanitized_summary",
    "artifact_relative_path",
    "artifact_sha256"
  ],
  "additionalProperties": false
}
