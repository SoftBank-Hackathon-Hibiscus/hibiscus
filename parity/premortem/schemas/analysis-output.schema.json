{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PremortemAnalysisOutputV1",
  "description": "김주영 모듈 내부 계약 구현안 v1. 팀 공통 test_result 계약이 아니다.",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]{1,64}$"
          },
          "category": {
            "enum": [
              "state_loss",
              "session_loss",
              "binding",
              "env_config",
              "application_logic",
              "unknown"
            ],
            "type": "string"
          },
          "observed_fact": {
            "type": "string"
          },
          "root_cause_hypothesis": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "source_locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "출력 또는 앱 root 기준 상대 경로. 실제 구현에서 절대 경로·..·역슬래시·드라이브·symlink·root 이탈을 추가 검증한다."
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "path",
                "line_start",
                "line_end"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "finding_id",
          "category",
          "observed_fact",
          "root_cause_hypothesis",
          "confidence",
          "evidence_ids",
          "source_locations"
        ],
        "additionalProperties": false
      }
    },
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "출력 또는 앱 root 기준 상대 경로. 실제 구현에서 절대 경로·..·역슬래시·드라이브·symlink·root 이탈을 추가 검증한다."
          },
          "before": {
            "type": "string",
            "minLength": 1
          },
          "after": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "before",
          "after"
        ],
        "additionalProperties": false
      },
      "maxItems": 5
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "manual_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "findings",
    "edits",
    "requirement_ids",
    "manual_actions"
  ],
  "additionalProperties": false
}
