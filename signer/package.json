{
  "name": "signer",
  "version": "0.1.0",
  "private": true,
  "description": "증명 기반 하이브리드 배포 서비스 - 승인·서명 (plan.json -> 승인 -> cosign 서명 -> sign_result.json)",
  "type": "module",
  "scripts": {
    "approve": "tsx src/cli.ts approve",
    "sign": "tsx src/cli.ts sign",
    "verify": "tsx src/cli.ts verify",
    "audit:verify": "tsx src/cli.ts audit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "contracts": "tsx scripts/contracts.ts"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
