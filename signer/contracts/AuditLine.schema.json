{
  "$id": "AuditLine.schema.json",
  "title": "AuditLine",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "줄 번호. 1 부터 빈 번호 없이"
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "앞 줄 hash. 첫 줄은 0 이 64개"
    },
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sign",
              "description": "서명 결정"
            },
            "time": {
              "type": "string",
              "description": "ISO 8601 시각"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$",
              "description": "파이프라인 실행 id (plan.run_id 그대로)"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "컨테이너 이미지 지문. 'sha256:' + 소문자 hex 64자 (plan.digest 그대로)"
            },
            "source_revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$",
              "description": "커밋 SHA. plan 에 있을 때만"
            },
            "plan_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "plan.plan_hash 그대로. 접두어 없이 소문자 hex 64자"
            },
            "result": {
              "type": "string",
              "enum": [
                "signed",
                "refused"
              ]
            },
            "requester": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$",
              "description": "GitHub 아이디 등 사람 id"
            },
            "approver": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]{1,64}$",
                  "description": "GitHub 아이디 등 사람 id"
                },
                {
                  "type": "null"
                }
              ],
              "description": "서명했거나 승인 기록이 있으면 그 사람, 없으면 null"
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "policy_block",
                    "no_targets",
                    "approval_missing",
                    "approval_mismatch",
                    "requester_mismatch",
                    "self_approval",
                    "approval_expired",
                    "sign_failed"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "refused 일 때 이유, signed 면 null"
            },
            "signature_ref": {
              "description": "signed 일 때 sign_result.signature_ref, refused 면 null",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "time",
            "run_id",
            "digest",
            "plan_hash",
            "result",
            "requester",
            "approver",
            "reason",
            "signature_ref"
          ],
          "additionalProperties": false,
          "description": "decisions.jsonl 의 kind: sign 한 줄"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sign_error",
              "description": "결정 전에 난 서명 실패"
            },
            "time": {
              "type": "string",
              "description": "ISO 8601 시각"
            },
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,39}$",
              "description": "SignerError 코드 (PLAN_INVALID, REQUESTER_INVALID 등)"
            },
            "message": {
              "type": "string",
              "maxLength": 500
            },
            "run_id": {
              "description": "plan 을 읽은 뒤에 난 오류면 그 실행 id",
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$"
            },
            "requester": {
              "description": "요청자로 들어온 값 그대로 (형식이 틀렸을 수 있음)",
              "type": "string",
              "maxLength": 100
            }
          },
          "required": [
            "kind",
            "time",
            "code",
            "message"
          ],
          "additionalProperties": false,
          "description": "plan·승인 기록 형식 오류처럼 서명 결정 전에 멈춘 시도. 감사 로그에만 남김 (decisions.jsonl 계약은 그대로)"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "revoke",
              "description": "서명 철회"
            },
            "time": {
              "type": "string",
              "description": "ISO 8601 시각"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "컨테이너 이미지 지문. 'sha256:' + 소문자 hex 64자 (plan.digest 그대로)"
            },
            "run_id": {
              "description": "있으면 그 실행의 서명만, 없으면 이 이미지의 서명 전부 (이후 서명도 거부)",
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$"
            },
            "reason": {
              "type": "string",
              "enum": [
                "vulnerability",
                "policy_changed",
                "key_compromise",
                "mistake"
              ]
            },
            "by": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$",
              "description": "철회한 사람"
            },
            "note": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            }
          },
          "required": [
            "kind",
            "time",
            "digest",
            "reason",
            "by"
          ],
          "additionalProperties": false,
          "description": "이미 한 서명을 더는 배포에 쓰지 않게 막는 기록. 감사 로그에만 남김 (decisions.jsonl 계약은 그대로)"
        }
      ]
    },
    "anchor": {
      "description": "signed 줄에만. 서명 직전 체인 끝 hash (이미지 서명 주석 audit_head 와 같은 값)",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "annotations": {
      "description": "signed 줄에만. 이미지 서명에 실제로 붙인 주석 전체. 주석만 바꾼 쌍둥이 서명과 구분하는 데 씀",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._~%!'()*+-]*$"
      }
    },
    "cancels": {
      "description": "서명 뒤 단계(자기 확인·증명서)가 실패한 refused 줄에만. 취소하는 signed 줄의 hash",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "이 줄 hash. sha256(키 정렬 JSON {seq, prev_hash, entry, anchor, annotations, cancels})"
    }
  },
  "required": [
    "seq",
    "prev_hash",
    "entry",
    "hash"
  ],
  "additionalProperties": false,
  "description": "서명 감사 로그(해시 체인) 한 줄. signer 안에서만 씀"
}
