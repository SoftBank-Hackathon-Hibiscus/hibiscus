{
  "$id": "SignResult.schema.json",
  "title": "SignResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "description": "파이프라인 실행 id (plan.run_id 그대로)"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "컨테이너 이미지 지문. 'sha256:' + 소문자 hex 64자 (plan.digest 그대로)"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "description": "커밋 SHA. plan 에 있을 때만"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "plan.plan_hash 그대로. 접두어 없이 소문자 hex 64자"
    },
    "targets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "plan.targets 그대로. 배포 쪽은 다시 판단하지 않음"
    },
    "failover_allowed": {
      "type": "boolean",
      "description": "plan.failover_allowed 그대로"
    },
    "requester": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "description": "GitHub 아이디 등 사람 id"
    },
    "approver": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "description": "승인한 사람. allow 면 auto"
    },
    "signature_ref": {
      "type": "string",
      "minLength": 1,
      "description": "서명 위치. cosign 로컬 키면 'cosign:<저장소>@<digest>' (서명은 그 이미지에 붙음). 시험 실행이면 'dry-run:...'"
    },
    "signed_at": {
      "type": "string",
      "description": "ISO 8601 시각"
    }
  },
  "required": [
    "run_id",
    "digest",
    "plan_hash",
    "targets",
    "failover_allowed",
    "requester",
    "approver",
    "signature_ref",
    "signed_at"
  ],
  "additionalProperties": false,
  "description": "서명 결과. 배포 파트가 읽음"
}
