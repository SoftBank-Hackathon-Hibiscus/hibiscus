{
  "$id": "Approval.schema.json",
  "title": "Approval",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "description": "파이프라인 실행 id (plan.run_id 그대로)"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "컨테이너 이미지 지문. 'sha256:' + 소문자 hex 64자 (plan.digest 그대로)"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "plan.plan_hash 그대로. 접두어 없이 소문자 hex 64자"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "승인할 때 본 plan.json 전체(키 정렬 JSON)의 sha256. 승인 뒤 targets 등이 바뀌면 달라짐"
    },
    "requester": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "description": "배포를 요청한 사람"
    },
    "approver": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "description": "승인한 사람. requester 와 달라야 함"
    },
    "approved_at": {
      "type": "string",
      "description": "ISO 8601 시각"
    }
  },
  "required": [
    "run_id",
    "digest",
    "plan_hash",
    "plan_sha256",
    "requester",
    "approver",
    "approved_at"
  ],
  "additionalProperties": false,
  "description": "needs_approval plan 에 대한 사람 승인 기록"
}
