SSH_HOST_KEY_SHA256=
SSH_READY_TIMEOUT_MS=10000
SSH_FORWARD_POLL_INTERVAL_MS=2000
SSH_SERVER_ALIVE_INTERVAL_SECONDS=15
SSH_SERVER_ALIVE_COUNT_MAX=3
SSH_SESSION_MAX_MS=900000
