BACKEND_API_URL=https://backend.example.com
AGENT_ID=
AGENT_TOKEN=
SSH_ENROLLMENT_TOKEN=
COSIGN_PUBLIC_KEY=../signer/keys/cosign.pub
AGENT_STATE_FILE=./data/agent-state.json
AGENT_POLL_INTERVAL_MS=2000
AGENT_HEARTBEAT_INTERVAL_MS=10000
BACKEND_REQUEST_TIMEOUT_MS=10000
COMMAND_TIMEOUT_MS=100000
DOCKER_STOP_TIMEOUT_SECONDS=10
DOCKER_COMMAND=docker
COSIGN_COMMAND=cosign
COSIGN_ALLOW_INSECURE_REGISTRY=false
COSIGN_INSECURE_IGNORE_TLOG=false
SSH_HOST=
SSH_PORT=2222
SSH_USER=
